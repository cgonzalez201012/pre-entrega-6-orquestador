# Copiá este archivo a .env y pegá tu clave. El .env NO se sube al repositorio.
ANTHROPIC_API_KEY=pega-aca-tu-clave

# Opcionales (valores por defecto entre parentesis)
# MODELO_LLM=claude-haiku-4-5            # modelo para todos los agentes
# MODELO_SUPERVISOR=claude-haiku-4-5     # pisa MODELO_LLM solo para el supervisor
# MODELO_ESPECIALISTAS=claude-haiku-4-5  # pisa MODELO_LLM solo para los especialistas
# MAX_PASOS=10                           # cuantas veces el supervisor puede delegar en una tarea (minimo 3)
# MAX_INTENTOS_POR_AGENTE=3              # veces que se le puede pedir su trabajo a un mismo agente
# RECURSION_ESPECIALISTA=12              # techo de pasos del ciclo ReAct interno de cada especialista
